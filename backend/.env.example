PORT=5000
USE_DB=false
JWT_SECRET=REPLACE_WITH_32_CHAR_MIN_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_REFRESH_TOKEN_BYTES=32
OTP_HASH_SECRET=REPLACE_WITH_32_CHAR_MIN_SECRET
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT=3
OTP_RESEND_INTERVAL_SECONDS=30
OTP_RATE_LIMIT_WINDOW_MS=300000
OTP_RATE_LIMIT_MAX=5
OTP_VERIFY_RATE_LIMIT_WINDOW_MS=300000
OTP_VERIFY_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_MS=300000
REFRESH_RATE_LIMIT_MAX=10

# Future MySQL configuration (not used yet)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=monyway
DB_USER=root
DB_PASSWORD=

# SMS.ir OTP (required only when USE_DB=true)
SMS_IR_API_KEY=REPLACE_WITH_SMS_PROVIDER_KEY
SMS_IR_TEMPLATE_ID=REPLACE_WITH_SMS_TEMPLATE_ID
# Optional: custom verify endpoint (default: https://api.sms.ir/v1/send/verify)
SMS_IR_VERIFY_URL=https://api.sms.ir/v1/send/verify
# Optional: sender line for non-template bulk SMS
SMS_IR_SENDER=
# Zarinpal course purchase (required when USE_DB=true)
ZARINPAL_MERCHANT_ID=your_merchant_id
ZARINPAL_CALLBACK_URL=https://your-api.com/api/payments/zarinpal/callback
ZARINPAL_SANDBOX=false
# Optional: redirect URLs after payment (default: /payment/success, /payment/failed)
ZARINPAL_SUCCESS_URL=https://your-app.com/payment/success
ZARINPAL_FAILURE_URL=https://your-app.com/payment/failed
SENTRY_DSN=
LOG_LEVEL=info
CORS_ORIGIN=https://your-frontend.com
REQUEST_BODY_LIMIT=1mb
GLOBAL_RATE_LIMIT_WINDOW_MS=600000
GLOBAL_RATE_LIMIT_MAX=300
USER_RATE_LIMIT_WINDOW_MS=60000
USER_RATE_LIMIT_MAX=30
COMMENT_RATE_LIMIT_WINDOW_MS=60000
COMMENT_RATE_LIMIT_MAX=3
AVATAR_MAX_BYTES=2097152
AVATAR_ALLOWED_MIME=image/jpeg,image/png,image/webp
AVATAR_VALIDATION_TIMEOUT_MS=5000
